# Copie para `.env` e preencha. O compose FALHA se algum obrigatorio faltar
# (sintaxe `${VAR:?}`) — de proposito: subir com senha vazia e pior que nao subir.

# --- obrigatorios ---
SF_POSTGRES_PASSWORD=
SF_ADMIN_PASSWORD=

# --- opcionais (defaults no compose) ---
SF_ADMIN_USERNAME=suricatoos
SF_LOG_LEVEL=INFO

# Workers uvicorn da API. Default do fork e 8; 2 basta para o caminho da integracao
# (um scan por vez + polling) e economiza ~1 GB.
SF_API_WORKERS=2

# Scans SIMULTANEOS. Medido: 1 scan satura ~1 GB no worker. Subir para 2 exige
# revisar o `mem_limit: 2g` do sf-scan-worker — e medir de novo, nao estimar.
SF_SCAN_CONCURRENCY=1
